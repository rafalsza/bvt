FROM python:3.12-slim-bookworm

COPY /requirements.txt ./
RUN python -m pip install --upgrade pip \
  && pip install --no-cache-dir -r requirements.txt

# user_data (config.yml, creds.yml, transactions.db) is mounted as a
# runtime volume - never bake credentials into the image.

WORKDIR /bitget_volatility_trading_bot
COPY /bitget_volatility_trading_bot/. ./bitget_volatility_trading_bot/

EXPOSE 8501
	
CMD ["python", "bitget_volatility_bot.py"]
