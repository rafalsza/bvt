FROM python:3.12-slim-bookworm

COPY /requirements.txt ./
RUN python -m pip install --upgrade pip \
  && pip install --no-cache-dir -r requirements.txt

# Package contents live directly in /app so that
# globals.user_data_path (parent of package + /user_data) resolves to
# /user_data - which compose mounts from the host.
# user_data (config.yml, creds.yml, transactions.db) is a runtime volume;
# credentials are never baked into the image.
WORKDIR /app
COPY /bitget_volatility_trading_bot/. ./

CMD ["python", "bitget_volatility_bot.py"]
